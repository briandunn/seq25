{
  "frontend/app/components/*.gts": {
    "type": "component",
    "alternate": "frontend/tests/integration/components/{}-test.gts"
  },
  "frontend/app/models/*.ts": {
    "type": "model",
    "alternate": "frontend/tests/unit/models/{}-test.ts"
  },
  "frontend/app/lib/*.ts": {
    "type": "lib",
    "alternate": "frontend/tests/unit/lib/{}-test.ts"
  },
  "frontend/app/services/*.ts": {
    "type": "service",
    "alternate": "frontend/tests/unit/services/{}-test.ts"
  },
  "frontend/app/routes/*.ts": { "type": "route" },
  "frontend/app/templates/*.gts": { "type": "template" },
  "frontend/app/styles/*.sass": { "type": "stylesheet" },
  "frontend/tests/acceptance/*-test.ts": { "type": "acceptance" },
  "frontend/tests/unit/*-test.ts": { "type": "test", "alternate": "frontend/app/{}.ts" },
  "backend/lib/*.rb": { "type": "lib", "alternate": "backend/specs/{}_spec.rb" },
  "backend/specs/*_spec.rb": { "type": "spec", "alternate": "backend/lib/{}.rb" }
}
