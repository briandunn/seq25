{
  "app/routes/*.js": {"type": "route"},
  "app/templates/*.hbs": {"type": "template"},
  "app/styles/*.sass": {"type": "stylesheet"},
  "app/views/*.js": {
    "type": "view",
    "template":  [
      "const {camelcase}View = Ember.View.extend({",
      "});",
      "",
      "export default {camelcase}View;"]
  },
  "app/models/*.js": {
    "type":      "model",
    "alternate": "tests/unit/models/{}-test.js"
  },
  "app/serializers/*.js": {
    "type":      "serializer",
    "alternate": "tests/unit/serializers/{}-test.js"
  },
  "app/components/*.js": {
    "type": "component",
    "alternate": "tests/unit/components/{}-test.js"
  },
  "app/controllers/*.js": {
    "type":      "controller",
    "alternate": "tests/unit/controllers/{}-test.js",
    "template":  [
      "const {camelcase}Controller = Ember.Controller.extend({",
      "});",
      "",
      "export default {camelcase}Controller;"]
  },
  "tests/unit/*-test.js": {
    "type":      "test",
    "alternate": "app/{}.js"
  },
  "tests/acceptance/*-test.js": {
    "type":      "acceptance"
  }
}
