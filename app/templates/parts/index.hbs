<section id="parts">
  <ul>
    {{#each part in parts}}
      {{#if part.placeholder}}
        <li class="empty" {{action 'addPart' part.name }}></li>
      {{/if}}
      {{#unless part.placeholder}}
        <li {{bind-attr class="part.isMuted:mute :part"}}>
          <header class="actions">
            <button {{action 'removePart' part}}>&minus;</button>
          </header>
          {{render 'parts/summary' part}}
        </li>
      {{/unless}}
    {{/each}}
  </ul>
</section>
