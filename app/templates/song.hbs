<section class="controls">
  <h2>Sequence</h2>
  {{#link-to 'song' model class="parts"}}
    Parts
  {{/link-to}}
  {{#link-to 'songs' class='songs'}}
    Songs
  {{/link-to}}
  <button {{action 'sendToServer' model}}>
    &uparrow;
  </button>
  {{#if remoteURL}}
    <dl>
      <dt>
        <label for="permalink">Permalink</label>
      </dt>
      <dd>
        <input id="permalink">
      </dd>
    </dl>
  {{/if}}
  <article>
    <dl>
      <dt>
        <label for="tempo">Tempo</label>
      </dt>
      <dd>{{view 'number' min=1 max=480 value=tempo id='tempo'}}</dd>
      {{outlet "part-controls"}}
    </dl>
    {{render 'transport'}}
  </article>
  {{outlet 'instruments'}}
</section>
{{outlet}}
